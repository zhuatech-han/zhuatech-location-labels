{
  "name": "zhuatech-location-labels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "知华库位标签：本地生成库位编号、条码及实际尺寸 PDF。",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src scripts tests eslint.config.js",
    "format": "prettier --write src scripts tests *.json *.js *.md docs",
    "format:check": "prettier --check src scripts tests *.json *.js *.md docs"
  },
  "dependencies": {
    "jsbarcode": "3.12.3",
    "jspdf": "4.2.1",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@zxing/library": "0.23.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9"
  }
}
